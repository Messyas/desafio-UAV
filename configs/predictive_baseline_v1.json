{
  "experiment_id": "predictive_baseline_v1",
  "status": "exploratory_baseline_not_confirmatory",
  "random_seed": 20260907,
  "threads": 4,
  "protocols": ["S0", "S1", "S2"],
  "folds": [0, 1, 2, 3, 4],
  "class_order": [
    "Normal Traffic",
    "Blackhole Attack",
    "Flooding Attack",
    "Sybil Attack",
    "Wormhole Attack"
  ],
  "primary_features": [
    "FlowDuration/s",
    "SrcPort",
    "DstPort",
    "TxPackets",
    "RxPackets",
    "LostPackets",
    "TxBytes",
    "RxBytes",
    "TxPacketRate/s",
    "RxPacketRate/s",
    "TxByteRate/s",
    "RxByteRate/s",
    "MeanDelay/s",
    "MeanJitter/s",
    "Throughput/Kbps",
    "MeanPacketSize",
    "PacketDropRate",
    "AverageHopCount"
  ],
  "models": {
    "dummy_prior": {
      "enabled": true,
      "scale": false,
      "parameters": {"strategy": "prior"}
    },
    "logistic_regression": {
      "enabled": true,
      "scale": true,
      "parameters": {"C": 1.0, "max_iter": 500, "solver": "lbfgs"}
    },
    "random_forest": {
      "enabled": true,
      "scale": false,
      "parameters": {
        "n_estimators": 200,
        "max_features": "sqrt",
        "min_samples_leaf": 1,
        "class_weight": "balanced_subsample"
      }
    },
    "extra_trees": {
      "enabled": true,
      "scale": false,
      "parameters": {
        "n_estimators": 200,
        "max_features": "sqrt",
        "min_samples_leaf": 1,
        "class_weight": "balanced"
      }
    },
    "xgboost": {
      "enabled": true,
      "scale": false,
      "parameters": {
        "n_estimators": 200,
        "max_depth": 6,
        "learning_rate": 0.1,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "objective": "multi:softprob",
        "eval_metric": "mlogloss",
        "tree_method": "hist"
      }
    },
    "mlp_compact": {
      "enabled": true,
      "scale": true,
      "parameters": {
        "hidden_layer_sizes": [64, 32],
        "activation": "relu",
        "alpha": 0.0001,
        "batch_size": 256,
        "learning_rate_init": 0.001,
        "max_iter": 100,
        "early_stopping": false
      }
    },
    "random_forest_with_flow_id": {
      "enabled": true,
      "scale": false,
      "diagnostic_only": true,
      "additional_features": ["FlowID"],
      "parameters": {
        "n_estimators": 200,
        "max_features": "sqrt",
        "min_samples_leaf": 1,
        "class_weight": "balanced_subsample"
      }
    }
  }
}
